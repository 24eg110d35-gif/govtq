# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT=3000

# PICNIE_API_KEY: Optional. Used for server-side PDF token receipt rendering and OCR document extraction.
# If omitted, SmartGov Queue gracefully uses its built-in printable browser engine and simulated OCR intake.
PICNIE_API_KEY="your_picnie_api_key_here"
PICNIE_ENDPOINT="https://api.picnie.com/v1"

# TIDB CLOUD CONFIGURATION: Optional. Used for connecting to TiDB Cloud Serverless (MySQL-compatible).
# If unconfigured, the system runs with the in-memory/localStorage synchronized prototype engine.
TIDB_HOST="gateway01.ap-southeast-1.prod.aws.tidbcloud.com"
TIDB_PORT=4000
TIDB_USER="your_cluster_user.root"
TIDB_PASSWORD="your_cluster_password"
TIDB_DATABASE="smartgov_queue"
TIDB_SSL_CA="/etc/ssl/certs/ca-certificates.crt"
